# Copia este archivo como .env y completa los valores de tu instancia MySQL / Amazon RDS.
# Para pruebas locales usa DB_HOST=127.0.0.1; en produccion AWS EC2 usa el endpoint de tu instancia RDS.
DB_HOST=tu-endpoint-rds.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=admin
DB_PASSWORD=tu_contrasena_segura
DB_CONNECT_TIMEOUT=10

# Autenticacion para endpoints de escritura (POST, PUT, DELETE) mediante el header X-API-Key.
# IMPORTANTE: Nunca publiques el valor real de API_KEY en el codigo JavaScript ni en GitHub.
# El frontend la lee en tiempo de ejecucion desde sessionStorage / localStorage.
API_KEY=coloca_una_clave_larga_y_segura
REQUIRE_API_KEY=true

# Configuracion explicita de CORS (sin comodin "*")
# Cuando publiques el frontend en GitHub Pages, coloca aqui su origen HTTPS
# (formato: https://<tu-usuario>.github.io, sin barra final ni nombre de repositorio):
FRONTEND_GITHUB_PAGES_URL=https://claudiahernandez03.github.io

# Origenes adicionales permitidos separados por comas:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://vehiculo-iot-api.duckdns.org,https://claudiahernandez03.github.io
CORS_ALLOW_CREDENTIALS=false

# Archivo opcional de estado de secuencia monotona de ordenes (por defecto: .orden_seq_state.json)
# ORDEN_SEQ_FILE=.orden_seq_state.json
