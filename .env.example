# Copia este archivo como .env y completa los valores de tu instancia RDS.
DB_HOST=tu-endpoint-rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=admin
DB_PASSWORD=tu_contrasena
# Recomendado. El POST requerirá este valor en el header x-api-key si no está vacío.
API_KEY=coloca_una_clave_larga
